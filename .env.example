# Copy to .env and fill in. NEVER commit the real .env.
# Generate secrets with, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"

FLASK_ENV=development

# Flask session signing key (required in production)
SECRET_KEY=

# Database — SQLite for the demo; swap for a postgresql:// URL to move to PostgreSQL.
# A bare relative SQLite name is stored in Flask's instance/ folder (auto-created).
DATABASE_URL=sqlite:///qvault.db

# Crypto-agility defaults (affect NEW keys only)
CRYPTO_BACKEND=quantcrypt
DEFAULT_SIG_ALGORITHM=ML-DSA-65
DEFAULT_KEM_ALGORITHM=ML-KEM-768

# Server master key — wraps vault-KEM and SYSTEM keys (64 hex chars = 32 bytes). Required in production.
SERVER_MASTER_KEY=

# Scheduler (APScheduler cron expressions)
KEY_ROTATION_CRON=0 3 * * *
PROPOSAL_EXPIRY_CRON=*/15 * * * *

# Dev/demo only: enables the deliberate ledger tamper demonstration control
ENABLE_TAMPER_DEMO=true

# Optional: directory containing liboqs oqs.dll if you build the liboqs backend
# LIBOQS_DLL_DIR=
