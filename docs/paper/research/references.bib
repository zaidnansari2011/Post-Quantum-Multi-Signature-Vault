  month        = nov,
  url          = {https://github.com/PQClean/PQClean/issues/526},
  urldate      = {2026-09-08},
  note         = {Opened 19 November 2023, closed without the change. Enumerates the four
                  modifications PQClean would need (WOTS_PRF and FORS_PRF address types,
                  PK.seed as an input to PRF, SHA-512 in place of SHA-256 for categories 3
                  and 5, and R and PK.seed into MGF1), which establishes that PQClean was
                  still at the round-3 v3.0 specification at that date. Author given as
                  the GitHub handle of the submitter}
}

