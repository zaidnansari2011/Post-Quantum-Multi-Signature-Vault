@misc{noble-postquantum,
  author       = {{noble-post-quantum contributors}},
  title        = {@noble/post-quantum: {ML-KEM}, {ML-DSA} and {SLH-DSA} in {J}ava{S}cript},
  howpublished = {npm package, version 0.7.0},
  url          = {https://github.com/paulmillr/noble-post-quantum},
  urldate      = {2026-09-08},
  note         = {The installed package README describes SLH-DSA as "hash-based Winternitz
                  signatures from FIPS-205" and exports slh_dsa_shake_256f among the
                  twelve FIPS 205 parameter sets. The implementation applies the FIPS 205
                  pure-mode prefix in its top-level sign/verify and exposes the unprefixed
                  slh_sign_internal separately as .internal. Author field is the project
                  name; no personal attribution was verified from a fetched page}
}

