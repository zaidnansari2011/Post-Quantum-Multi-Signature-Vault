# Keep secrets, local state and build noise out of the image.
#
# instance/ is the important one: it holds the live SQLite database, the witness key and the
# encrypted file blobs. Baking those into an image that gets pushed to a registry would publish
# real key material and every stored decision.

.env
.env.*
!.env.example

instance/
*.db
*.db-shm
*.db-wal
*.sqlite

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

.git/
.github/
node_modules/
tests/interop/node_modules/

documents/
# Contract dependencies and build output (~65 MB); the app never compiles Solidity at runtime.
# The rest of chain/ stays in the image, because the running app needs the deployment records
# (plan D16). The treasury ABI and bytecode the app deploys with (Phase 5) will be committed as an
# artefact under qvault/chain/, not read from chain/out/.
chain/lib/
chain/out/
chain/cache/
chain/broadcast/
*.docx
*.pptx
*.pdf

.vscode/
.idea/
Thumbs.db
.DS_Store
