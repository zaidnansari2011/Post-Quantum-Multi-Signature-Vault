{
  "expo": {
    "name": "Q-Vault",
    "slug": "qvault",
    "owner": "zaid7864",
    "scheme": "qvault",
    "version": "1.0.0",
    "runtimeVersion": "rework-1",
    "updates": {
      "url": "https://u.expo.dev/abfa50c5-38c5-4fd7-a01d-7c0d0dd9c028",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "apiBaseUrl": "https://project4.zaidansari.tech",
      "eas": {
        "projectId": "abfa50c5-38c5-4fd7-a01d-7c0d0dd9c028"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qvault.approvals",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Q-Vault uses Face ID to authorise a signature with the key held on this device."
      }
    },
    "android": {
      "package": "com.qvault.approvals",
      "versionCode": 2,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E1729",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.DETECT_SCREEN_CAPTURE"
      ],
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "project4.zaidansari.tech",
              "pathPattern": "/vaults/.*/proposals/.*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "qvault-staging.livelybeach-69506dc5.centralindia.azurecontainerapps.io",
              "pathPattern": "/vaults/.*/proposals/.*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Q-Vault uses Face ID to authorise a signature with the key held on this device."
        }
      ],
      "expo-secure-store",
      "./plugins/withReleaseSigning",
      "./plugins/withAndroidBuildTuning",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D60C3",
          "defaultChannel": "needs_you"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#11161E"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Q-Vault uses the camera only to scan a QR code you point it at.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
