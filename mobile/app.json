{
  "expo": {
    "name": "Q-Vault",
    "slug": "qvault",
    "owner": "zaid7864",
    "scheme": "qvault",
    "version": "1.0.0",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/abfa50c5-38c5-4fd7-a01d-7c0d0dd9c028",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "extra": {
      "apiBaseUrl": "https://project4.zaidansari.tech",
      "eas": {
        "projectId": "abfa50c5-38c5-4fd7-a01d-7c0d0dd9c028"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qvault.approvals",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Q-Vault uses Face ID to authorise a signature with the key held on this device."
      }
    },
    "android": {
      "package": "com.qvault.approvals",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#15191C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Q-Vault uses Face ID to authorise a signature with the key held on this device."
        }
      ],
      "expo-secure-store"
    ]
  }
}
